# BlindSpot configuration — copy to `.env` and fill in your keys.
# `.env` is git-ignored; never commit real keys.

# Primary reasoning engine (Google AI Studio key)
GEMINI_API_KEY=
# Model override, e.g. gemini-2.5-flash, gemini-2.5-pro, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback (OpenAI or any OpenAI-compatible endpoint)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
